{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "exusiai-stat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [],
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "exusiai-stat", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "UPLOAD_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vars": { "UPLOAD_ENABLED": "false", "SHARED_PAGES": "true", "STATIC_STATS_READY": "true" },
  "triggers": { "crons": [] },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.05 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
