<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../local.props" Condition="Exists('../../local.props')" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RitsuLibAutoCopy>false</RitsuLibAutoCopy>
    <GodotProjectDir>$(MSBuildProjectDirectory)/../../</GodotProjectDir>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="GodotProjectDir" />
    <PackageReference Include="$(RitsuLibPackageId)" Version="$(RitsuLibVersion)" GeneratePathProperty="true" />
    <ProjectReference Include="../../AK_Exusiai.csproj" />
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" />
    <!-- This console test runs outside the game, so copy framework assemblies only into its own output. -->
    <Content Include="$(PkgSTS2_RitsuLib)/lib/net9.0/STS2-RitsuLib*.dll" Condition="'$(GameApiTarget)' == '0.113.0'" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgSTS2_RitsuLib_Compat_0_111_0)/lib/net9.0/STS2-RitsuLib*.dll" Condition="'$(GameApiTarget)' == '0.111.0'" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
